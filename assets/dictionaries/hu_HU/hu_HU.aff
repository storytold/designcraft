NAME Magyar Ispell helyesírási szótár
LANG hu_HU
HOME http://magyarispell.sourceforge.net
VERSION Magyar 1.9
SET UTF-8
FLAG num
KEY öüó|qwertzuiopőú|asdfghjkléáű|íyxcvbnm
TRY íóútaeslzánorhgkiédmyőpvöbucfjüűxwq-.à
COMPOUNDMIN 1
COMPOUNDFLAG 89
COMPOUNDFORBIDFLAG 37
COMPOUNDPERMITFLAG 64
COMPOUNDSYLLABLE 6 aáeéiíoóöőuúüű
SYLLABLENUM klmc

NOSUGGEST 61
KEEPCASE 63
#COMPOUND 1
#COMPOUND ,-,

# obsolete
COMPOUNDFIRST 118
COMPOUNDLAST 120
ONLYROOT 117
#COMPOUNDWORD 2 y
HU_KOTOHANGZO 63

# new (> Hunspell-1.0-RC2)
COMPOUNDBEGIN 118
COMPOUNDEND 120
NEEDAFFIX 117
ONLYINCOMPOUND 124
# 2. parameter only for back compatibility:
COMPOUNDWORDMAX 2 y
COMPOUNDROOT 121

CHECKCOMPOUNDDUP
CHECKCOMPOUNDTRIPLE
CHECKCOMPOUNDREP
CHECKCOMPOUNDCASE
CHECKCOMPOUNDPATTERN 7
CHECKCOMPOUNDPATTERN ccs cs
CHECKCOMPOUNDPATTERN ggy gy
CHECKCOMPOUNDPATTERN lly ly
CHECKCOMPOUNDPATTERN nny ny
CHECKCOMPOUNDPATTERN ssz sz
CHECKCOMPOUNDPATTERN tty ty
CHECKCOMPOUNDPATTERN sz szerű

FORBIDDENWORD 119
WORDCHARS -.‰§%°0123456789–€'’ﬃﬄﬀﬁﬂ

SUBSTANDARD 38
GENERATE 40
LEMMA_PRESENT 41

MAP 5
MAP aá
MAP eé
MAP ií
MAP oóöő
MAP uúüű

BREAK 10
BREAK –
BREAK -
BREAK ^-
BREAK -$
BREAK -beli$
BREAK -féle$
BREAK "
BREAK ”
BREAK ?
BREAK !

# számok
# 0. osztály: számjegyek
# 1. osztály: számjegyek, %, ezrelékjel, °, §, számjegyek + . és toldalékolt alakjaik
# 2. osztály: tizedesvessző

COMPOUNDRULE 2
COMPOUNDRULE (48)*(49)
COMPOUNDRULE (48)(48)*(50)(48)*(49)

# (1)-ben, [3]-ban, c)-vel
# LibreOffice hibajegy:
# https://bugs.documentfoundation.org/show_bug.cgi?id=116072
IGNORE ()]

# f-ligatúrák

ICONV 5
ICONV ﬃ ffi
ICONV ﬄ ffl
ICONV ﬀ ff
ICONV ﬁ fi
ICONV ﬂ fl

#OCONV 5
#OCONV ffi ﬃ
#OCONV ffl ﬄ
#OCONV ff ﬀ
#OCONV fi ﬁ
#OCONV fl ﬂ

# replacement table for
# - multicharacter suggestions
# - well-sorted suggestions

