%!PS-Adobe-3.0 Resource-ProcSet
<<
  /AllowTransparency false
  /CheckCompliance [
    /PDFX3:2002
  ]
  /ColorConversionStrategy /UseDeviceIndependentColor
  /ColorImageDict <<
    /HSamples [
      1
      1
    ]
  >>
  /ColorImageDownsampleThreshold 1
  /ColorImageFilter /DCTEncode
  /ColorImageResolution 300
  /CompatibilityLevel 1.3
  /DefaultRenderingIntent /Default
  /Description <<
    /ENU (Synthetic test preset (with nested brackets) for a template export.)
  >>
  /DownsampleColorImages true
  /Optimize false
  /OtherNamespaces [
    <<
      /Namespace [
        (Adobe)
        (InDesign)
        (4.0)
      ]
      /SimulateOverprint /Legacy
    >>
    <<
      /AddBleedMarks false
      /AddColorBars false
      /AddCropMarks false
      /AddPageInfo false
      /AddRegMarks false
      /BleedOffset [
        0
        0
        0
        0
      ]
      /GenerateStructure false
      /MarksOffset 6
      /MarksWeight 0.25000
      /UseDocumentBleed true
    >>
  ]
  /PDFX1aCheck false
  /PDFX3Check true
  /PDFXOutputIntentProfile (U.S. Web Coated \050SWOP\051 v2)
  /SubsetFonts true
>> setdistillerparams
<<
  /HWResolution [2400 2400]
  /PageSize [612 792]
  /SubsetFonts false
>> setpagedevice
