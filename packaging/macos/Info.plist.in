<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>DesignCraft</string>
  <key>CFBundleName</key>
  <string>DesignCraft</string>
  <key>CFBundleExecutable</key>
  <string>DesignCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.designcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>DesignCraftVersion</key>
  <string>@VERSION@</string>
  <key>DesignCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>DesignCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the DesignCraft authors. MIT OR Apache-2.0.</string>

  <!-- What DesignCraft opens. Without this key Finder and the Dock refuse every drop on the
       app icon and DesignCraft never appears in "Open With". These are the formats the app
       opens as documents (main.rs open filter, ui-egui file.open); placeable formats
       (images, PDF, text) are not listed. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>DesignCraft Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>DesignCraft</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.designcraft.document</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>InDesign Markup Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <!-- Alternate: offered in Open With and accepts drops, but does not take the default
           away from InDesign. -->
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.designcraft.idml</string>
      </array>
    </dict>
    <!-- Fallback by extension. If another installed app (InDesign) exports its own UTI for
         .idml, files get that UTI instead of the one imported below and the entry above no
         longer matches. A legacy extension entry matches regardless of UTI. It must be its own
         dict: in a dict that has LSItemContentTypes, the extension keys are ignored. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>InDesign Markup Document (by extension)</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>idml</string>
      </array>
    </dict>
  </array>

  <!-- Designcraft's own format. The app saves .designcraft; .pcraft kept for the Windows
       installer's association until the two are reconciled. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.designcraft.document</string>
      <key>UTTypeDescription</key>
      <string>DesignCraft Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>DesignCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>designcraft</string>
          <string>pcraft</string>
        </array>
        <key>public.mime-type</key>
        <array><string>application/x-designcraft</string></array>
      </dict>
    </dict>
  </array>
  <!-- Types macOS may not know; the system's own declaration wins when it has one. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.adobe.photoshop-large-image</string>
      <key>UTTypeDescription</key>
      <string>Photoshop Large Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>psb</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.designcraft.qoi</string>
      <key>UTTypeDescription</key>
      <string>QOI Image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>qoi</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.designcraft.idml</string>
      <key>UTTypeDescription</key>
      <string>InDesign Markup Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <!-- IDML is a ZIP package of XML files. -->
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>idml</string></array>
        <key>public.mime-type</key>
        <array><string>application/vnd.adobe.indesign-idml-package</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
